{
  "//": "Reference only — adapters/claude-code/install.sh merges all of this into your USER-level ~/.claude/settings.json automatically (with a backup, idempotent; user-level because rate limits are account-wide). Use this file if you prefer to merge by hand, or copy the hooks block into a project's .claude/settings.json with adjusted paths to scope the guard to one project. CLAUDE_5H_TOKEN_LIMIT is only needed as a fallback on Claude Code < 2.1.80 — with the status-line bridge installed, real data is used and no calibration is required.",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline-usage-bridge.sh"
  },
  "env": {
    "CLAUDE_5H_THRESHOLD": "90",
    "CLAUDE_5H_AUTORESUME": "1",
    "CLAUDE_5H_TOKEN_LIMIT": "0"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/usage-limit-guard.sh report"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/usage-limit-guard.sh guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/usage-limit-guard.sh schedule-resume"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/usage-limit-guard.sh resume-on-failure"
          }
        ]
      }
    ]
  }
}
